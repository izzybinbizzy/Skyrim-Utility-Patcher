<Application x:Class="ToolRunner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Light"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <!-- the Fluent brushes that take Windows' accent, taking ours instead; Theme.SetMode swaps in the dark set -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Tool Runner;component/AccentLight.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- the default look, Daylight (white and blue - his pick); every color is a token a theme may change. These values are
           Themes\Daylight.json's: a test holds the two equal -->
      <Color x:Key="BgColor">#E9EEF5</Color>
      <Color x:Key="PanelColor">#FFFFFF</Color>
      <Color x:Key="Panel2Color">#F3F6FA</Color>
      <Color x:Key="LineColor">#C9D3E0</Color>
      <Color x:Key="AccentColor">#1F6FD1</Color>
      <Color x:Key="AccentLightColor">#0E4FA0</Color>
      <Color x:Key="AccentDimColor">#8DB3E2</Color>
      <Color x:Key="TextColor">#1B2430</Color>
      <Color x:Key="MutedColor">#566373</Color>
      <Color x:Key="GoodColor">#18794A</Color>
      <Color x:Key="BadColor">#C2362B</Color>
      <Color x:Key="WarnColor">#8F5A00</Color>
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <Color x:Key="HoverFillColor">#DCE8F7</Color>
      <Color x:Key="BannerBadColor">#FBE3E0</Color>
      <Color x:Key="GuidedFillColor">#E3EEFB</Color>
      <Color x:Key="ShadeColor">#660B1A2E</Color>
      <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
      <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
      <SolidColorBrush x:Key="Panel2" Color="{StaticResource Panel2Color}"/>
      <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
      <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
      <SolidColorBrush x:Key="AccentLight" Color="{StaticResource AccentLightColor}"/>
      <SolidColorBrush x:Key="AccentDim" Color="{StaticResource AccentDimColor}"/>
      <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
      <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
      <SolidColorBrush x:Key="Good" Color="{StaticResource GoodColor}"/>
      <SolidColorBrush x:Key="Bad" Color="{StaticResource BadColor}"/>
      <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
      <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}"/>
      <SolidColorBrush x:Key="HoverFill" Color="{StaticResource HoverFillColor}"/>
      <SolidColorBrush x:Key="BannerBad" Color="{StaticResource BannerBadColor}"/>
      <SolidColorBrush x:Key="GuidedFill" Color="{StaticResource GuidedFillColor}"/>
      <SolidColorBrush x:Key="Shade" Color="{StaticResource ShadeColor}"/>
      <LinearGradientBrush x:Key="AccentBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A62BF" Offset="0"/>
        <GradientStop Color="#2775D6" Offset="1"/>
      </LinearGradientBrush>
      <!-- the Fluent theme's accent, ours -->
      <Color x:Key="SystemAccentColor">#1F6FD1</Color>
      <Color x:Key="SystemAccentColorLight1">#3784E1</Color>
      <Color x:Key="SystemAccentColorLight2">#5B9AE7</Color>
      <Color x:Key="SystemAccentColorLight3">#7EB0EC</Color>
      <Color x:Key="SystemAccentColorDark1">#1A5CAD</Color>
      <Color x:Key="SystemAccentColorDark2">#14498A</Color>
      <Color x:Key="SystemAccentColorDark3">#0F3666</Color>
      <!-- a selected list row (past runs, steps): the Fluent one takes Windows' own accent -->
      <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="{DynamicResource AccentDimColor}" Opacity="0.55"/>
      <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="{DynamicResource AccentDimColor}" Opacity="0.7"/>
      <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush" Color="{DynamicResource AccentDimColor}" Opacity="0.85"/>
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressedThemeBrush" Color="{DynamicResource AccentDimColor}" Opacity="0.85"/>
      <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{DynamicResource TextColor}"/>

      <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
      <FontFamily x:Key="HeadFont">Segoe UI Variable Display Semibold, Segoe UI Semibold</FontFamily>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
      <!-- sizes and shapes a theme may change (Theme.cs) -->
      <sys:Double x:Key="SizeHeading1">20</sys:Double>
      <sys:Double x:Key="SizeStepTitle">24</sys:Double>
      <sys:Double x:Key="SizeClock">18</sys:Double>
      <sys:Double x:Key="SizeHeading2">13</sys:Double>
      <sys:Double x:Key="SizeVerdict">15</sys:Double>
      <sys:Double x:Key="SizeBody">14</sys:Double>
      <sys:Double x:Key="SizeSmall">12.5</sys:Double>
      <sys:Double x:Key="SizeLog">12.5</sys:Double>
      <sys:Double x:Key="SizePrimaryButton">15</sys:Double>
      <sys:Double x:Key="ProgressBarHeight">5</sys:Double>
      <CornerRadius x:Key="CardCorner">14</CornerRadius>
      <CornerRadius x:Key="ButtonCorner">12</CornerRadius>
      <CornerRadius x:Key="CheckBoxCorner">5</CornerRadius>
      <CornerRadius x:Key="GuidedBoxCorner">12</CornerRadius>
      <BitmapImage x:Key="Logo" UriSource="pack://application:,,,/Tool Runner;component/Logo.png"/>

      <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource SizeHeading1}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentLight}"/>
      </Style>
      <!-- a section's small heading -->
      <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource SizeHeading2}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
      </Style>
      <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="{DynamicResource SizeSmall}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCorner}"/>
        <Setter Property="Padding" Value="18"/>
      </Style>

      <!-- the primary button: the accent's gradient -->
      <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="FontFamily" Value="{DynamicResource HeadFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource SizePrimaryButton}"/>
        <Setter Property="Padding" Value="26,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="b" Background="{DynamicResource AccentBar}" CornerRadius="{DynamicResource ButtonCorner}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <Border x:Name="focus" CornerRadius="{DynamicResource ButtonCorner}" BorderBrush="{DynamicResource AccentLight}" BorderThickness="2" Margin="-3" Visibility="Collapsed"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.75"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.3"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- the outlined button -->
      <Style x:Key="Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentLight}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource AccentDim}" BorderThickness="1" CornerRadius="{DynamicResource ButtonCorner}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLight}"/>
                  <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverFill}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLight}"/>
                  <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- a check box in the accent (the Fluent one takes Windows' own accent color) -->
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <Grid Width="18" Height="18" VerticalAlignment="Center">
                  <Border x:Name="box" CornerRadius="{DynamicResource CheckBoxCorner}" BorderThickness="1.5" BorderBrush="{DynamicResource AccentDim}" Background="{DynamicResource Panel2}"/>
                  <Path x:Name="tick" Data="M 4,9 L 7.5,12.5 L 14,5.5" Stroke="{DynamicResource OnAccent}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                  <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                  <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentLight}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentLight}"/>
                  <Setter TargetName="box" Property="BorderThickness" Value="2.5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
